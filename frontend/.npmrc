legacy-peer-deps=true

# 国内镜像源，避免 Docker 构建时 npm registry 超时
registry=https://registry.npmmirror.com

# pnpm v10 新安全模型：必须显式白名单允许 postinstall 脚本的包
# ignore-scripts=false 在 pnpm v10 中已不生效，改用 onlyBuiltDependencies
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=vue-demi

# 增大 fetch 超时（单位 ms），避免 mermaid 等大包偶发超时
fetch-timeout=120000
fetch-retries=5
fetch-retry-mintimeout=10000
